# Copy this file to .env and fill in your real SMTP details.
# NEVER commit your real .env file (it is gitignored).

# For local testing, run a throwaway debug SMTP server that just prints
# messages to stdout and never delivers anything:
#   python3 -m smtpd -c DebuggingServer -n localhost:1025
# then use the defaults below (no auth, no TLS).

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=false

FROM_EMAIL=you@example.com
FROM_NAME=Your Name
